{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arithmomaniac/sefaria-web-components/packages/model/contracts/source-card.schema.json",
  "title": "Sefaria MCP source card",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref", "segments"],
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "heRef": {
      "type": "string",
      "minLength": 1
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "translations"],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/textBlock"
        },
        "translations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textBlock"
          }
        }
      }
    },
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "language", "direction", "versionTitle"],
      "properties": {
        "content": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": ["ltr", "rtl"]
        },
        "versionTitle": {
          "type": "string",
          "minLength": 1
        },
        "shortVersionTitle": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "versionSource": {
          "type": "string"
        },
        "versionUrl": {
          "type": "string"
        },
        "versionNotes": {
          "type": "string"
        },
        "digitizedBySefaria": {
          "type": "boolean"
        }
      }
    }
  }
}
